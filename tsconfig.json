{
  // Nuxt generates the auto-import, component and Nitro types into .nuxt.
  // Extending them is what makes `useTrip`, `defineEventHandler` and friends
  // known to the type checker instead of appearing as undefined globals.
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    "app.vue",
    "components/**/*.vue",
    "composables/**/*.ts",
    "pages/**/*.vue",
    "server/**/*.ts",
    "src/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".output", "dist"]
}
